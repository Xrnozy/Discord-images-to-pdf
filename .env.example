DISCORD_BOT_TOKEN=your_bot_token_here
OPEN_BROWSER=1

# Path to your ScreenshotToDiscord app (started automatically by start.bat)
DISCORD_BOT_APP=..\gmeet-auto-ss\ScreenshotToDiscord\bin\Debug\net8.0-windows\ScreenshotToDiscord.exe

# Saved when you select/retrieve a channel (restored on next open, used for PDF folder names)
RETRIEVAL_GUILD_ID=
RETRIEVAL_CATEGORY_ID=
RETRIEVAL_CHANNEL_ID=
RETRIEVAL_CHANNEL_NAME=
RETRIEVAL_ALL_IN_CATEGORY=false
